# PostgreSQL 接続文字列（docker-compose.yml と対応。ホストポートは 5435）
DATABASE_URL=postgres://tsunagu:tsunagu@localhost:5435/tsunagu?sslmode=disable
# APIの待ち受けポート（任意・既定: 8082）
PORT=8082

JWT_SECRET=dev-secret-change-me
# トレースの送信先（任意）。ローカルで Jaeger を使うとき（make trace-up）だけ有効化する。
# 未設定なら送信しない（no-op）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
