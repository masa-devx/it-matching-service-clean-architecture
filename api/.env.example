# このファイルは見本（コミット対象）。実値は `cp .env.example .env` で作成する（.env は gitignore 済み）

# PostgreSQL 接続文字列（docker-compose.yml の設定と対応。ホストポートは 5434）
DATABASE_URL=postgres://tsunagu:tsunagu@localhost:5434/tsunagu?sslmode=disable

# JWT 署名鍵（ローカルは任意の文字列でよい。本番は十分に長いランダム値へ差し替える）
JWT_SECRET=dev-secret-change-me

# APIの待ち受けポート（任意・既定: 8081）
PORT=8081
# CORSで許可するフロントのオリジン（任意・既定: http://localhost:3000）
WEB_ORIGIN=http://localhost:3000